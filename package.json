{
  "name": "workout-buddy",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -n backend,frontend \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm start --workspace=frontend",
    "build": "npm run build --workspace=frontend",
    "start:backend": "npm start --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
